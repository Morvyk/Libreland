# pacman scriptlet for the libreland package.

# Files this package now owns. If a copy already exists at any of these
# paths and is NOT owned by a package (e.g. you hand-placed the contrib
# configs earlier), remove it before extraction so pacman doesn't abort
# with a "exists in filesystem" conflict — the package's version wins.
_libreland_managed=(
    usr/share/xdg-desktop-portal/libreland-portals.conf
    usr/share/xdg-desktop-portal/portals/libreland.portal
    usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.libreland.service
    usr/lib/systemd/user/libreland-xdg-desktop-portal.service
    usr/share/wayland-sessions/libreland.desktop
)

# Left behind by versions before Libreland had its own portal backend: the
# chooser config for xdg-desktop-portal-wlr, which is no longer used (the
# monitor picker is built into the backend). Harmless if it stays, but it
# would keep pointing a now-optional package at us.
_libreland_stale=(
    etc/xdg/xdg-desktop-portal-wlr/libreland
)

_libreland_clear_unowned() {
    local f
    for f in "${_libreland_managed[@]}"; do
        if [ -e "/$f" ] && ! pacman -Qqo "/$f" >/dev/null 2>&1; then
            rm -f "/$f"
        fi
    done
}

_libreland_clear_stale() {
    local f
    for f in "${_libreland_stale[@]}"; do
        # Only remove one we installed ourselves; a hand-written config is
        # the user's business.
        if [ -e "/$f" ] && pacman -Qqo "/$f" 2>/dev/null | grep -q libreland; then
            rm -f "/$f"
        fi
    done
}

pre_install() {
    _libreland_clear_unowned
}

pre_upgrade() {
    _libreland_clear_unowned
}

post_upgrade() {
    _libreland_clear_stale
}
