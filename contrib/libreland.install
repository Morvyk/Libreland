# pacman scriptlet for the libreland package.
#
# NOTE ON FILE CONFLICTS. There used to be a pre_install/pre_upgrade hook here
# that deleted unowned copies of the files this package installs, so that a
# hand-placed config wouldn't abort the transaction. It cannot work, and never
# could: pacman detects file conflicts while preparing the transaction, which
# is *before* any scriptlet of the packages in it runs. By the time pre_install
# would fire, pacman has already refused with
#
#     error: failed to commit transaction (conflicting files)
#
# So the hook is gone rather than left as a comforting lie. If you hand-copied
# the portal files (see the manual install in Documentation.md) and now hit
# that error, delete the paths it names and install again — or, if you are sure
# they are yours to lose, `pacman -U --overwrite '/usr/share/xdg-desktop-portal/*'`
# and friends. Nothing a package installs can decide that for you.

# An obsolete file we used to ship: the chooser config for
# xdg-desktop-portal-wlr, which is no longer used at all (the monitor picker
# is built into our own portal backend now). Removing it after an upgrade is
# safe — this runs once the new files are in place — and unlike the conflict
# case above, it is a file *we* own, so it is ours to clean up.
_libreland_stale=(
    etc/xdg/xdg-desktop-portal-wlr/libreland
)

_libreland_clear_stale() {
    local f
    for f in "${_libreland_stale[@]}"; do
        # Only remove one this package installed; a hand-written config at the
        # same path is the user's business.
        if { [ -e "/$f" ] || [ -L "/$f" ]; } &&
            pacman -Qqo "/$f" 2>/dev/null | grep -q libreland; then
            rm -f "/$f"
        fi
    done
}

post_upgrade() {
    _libreland_clear_stale
}
